<Window x:Class="FolderIconChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FolderIconChanger.Localization"
        Title="{x:Static loc:Strings.AppTitle}"
        Icon="Assets/app-icon.ico"
        Width="620" Height="760"
        MinWidth="560" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= Header ============================= -->
        <Border Grid.Row="0" Background="{StaticResource BackdropBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,16">
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="10"
                        Background="{StaticResource CardInnerBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Margin="0,0,14,0">
                    <Image Source="Assets/app-icon.ico" Stretch="Uniform" Margin="3" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:Strings.AppTitle}" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Static loc:Strings.AppSubtitle}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================= Body ============================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,6">
            <StackPanel>
                <!-- Custom image card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.ImageSectionTitle}"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Border x:Name="DropBorder" CornerRadius="12"
                                Background="{StaticResource CardInnerBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" Height="230"
                                AllowDrop="True"
                                DragOver="DropBorder_DragOver"
                                Drop="DropBorder_Drop"
                                Cursor="Hand">
                            <Grid>
                                <Rectangle Fill="{StaticResource CheckerBrush}" RadiusX="12" RadiusY="12" />
                                <Border CornerRadius="12" Background="#CC1F2229" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="18"
                                       Visibility="Collapsed" />
                                <StackPanel x:Name="DropHintPanel" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Margin="20">
                                    <TextBlock Text="🖼" FontSize="30" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Static loc:Strings.ImageDropHint}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Text="{x:Static loc:Strings.ImageEmptyHint}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- mini previews: original vs folder icon -->
                        <Grid Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.SelectedImageLabel}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Border Width="86" Height="86" CornerRadius="10"
                                        Background="{StaticResource CardInnerBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" Padding="4">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource CheckerBrush}" RadiusX="8" RadiusY="8" />
                                        <Image x:Name="SelectedThumb" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0">
                                <TextBlock Text="↓" FontSize="20"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.FolderIconPreviewLabel}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Border Width="86" Height="86" CornerRadius="10"
                                        Background="{StaticResource CardInnerBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1.5" Padding="4">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource CheckerBrush}" RadiusX="8" RadiusY="8" />
                                        <Image x:Name="FolderThumb" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Button Content="{x:Static loc:Strings.ChooseImageButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ChooseImage_Click" />
                    </StackPanel>
                </Border>

                <!-- Target folder card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.FolderSectionTitle}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="FolderPathBox"
                                 Style="{StaticResource PathTextBoxStyle}"
                                 ToolTipService.InitialShowDelay="0" />
                        <Button Content="{x:Static loc:Strings.ChooseFolderButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,12,0,0"
                                Click="ChooseFolder_Click" />
                    </StackPanel>
                </Border>

                <!-- Apply -->
                <Button x:Name="ApplyButton" Content="{x:Static loc:Strings.ApplyButton}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48" FontSize="14"
                        Margin="0,18,0,0"
                        IsDefault="True"
                        Click="Apply_Click" />

                <!-- Restore -->
                <Button x:Name="RestoreButton" Content="{x:Static loc:Strings.RestoreButton}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,10,0,0"
                        Click="Restore_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============================= Status ============================ -->
        <Border Grid.Row="2" Background="{StaticResource BackdropBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Spinner" Grid.Column="0" IsIndeterminate="True"
                             Width="16" Height="16" Margin="0,0,10,0"
                             Visibility="Collapsed"
                             Foreground="{StaticResource AccentBrush}"
                             Background="Transparent" BorderThickness="0" />
                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="8" Height="8"
                         Margin="4,0,14,0" VerticalAlignment="Center"
                         Fill="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Text="{x:Static loc:Strings.StatusReady}"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>