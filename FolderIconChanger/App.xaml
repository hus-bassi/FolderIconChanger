<Application x:Class="FolderIconChanger.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FolderIconChanger.Localization">
    <Application.Resources>

        <!-- ============================================================ -->
        <!-- Colors                                                       -->
        <!-- ============================================================ -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FF17191E" />
        <SolidColorBrush x:Key="BackdropBrush"   Color="#FF141519" />
        <SolidColorBrush x:Key="CardBrush"       Color="#FF1F2229" />
        <SolidColorBrush x:Key="CardInnerBrush"  Color="#FF262B34" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FF323743" />
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFF2F3F7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9CA3B2" />
        <SolidColorBrush x:Key="TextMutedBrush"     Color="#FF6B7280" />
        <SolidColorBrush x:Key="AccentBrush"        Color="#FF4C8DFF" />
        <SolidColorBrush x:Key="AccentBrushHover"   Color="#FF6BA1FF" />
        <SolidColorBrush x:Key="AccentBrushPressed" Color="#FF3D78E6" />
        <SolidColorBrush x:Key="SuccessBrush"       Color="#FF3DDC7F" />
        <SolidColorBrush x:Key="ErrorBrush"         Color="#FFF06067" />
        <SolidColorBrush x:Key="WarningBrush"       Color="#FFFFC25E" />
        <SolidColorBrush x:Key="CheckerDark"        Color="#FF15171B" />
        <SolidColorBrush x:Key="CheckerLight"       Color="#FF23272F" />

        <!-- ============================================================ -->
        <!-- Transparency checkerboard                                     -->
        <!-- ============================================================ -->
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource CheckerLight}" Geometry="M0,0 L8,0 L8,8 L0,8 Z" />
                    <GeometryDrawing Brush="{StaticResource CheckerDark}"  Geometry="M8,0 L16,0 L16,8 L8,8 Z" />
                    <GeometryDrawing Brush="{StaticResource CheckerDark}"  Geometry="M0,8 L8,8 L8,16 L0,16 Z" />
                    <GeometryDrawing Brush="{StaticResource CheckerLight}" Geometry="M8,8 L16,8 L16,16 L8,16 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ============================================================ -->
        <!-- Base text styles                                              -->
        <!-- ============================================================ -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <!-- ============================================================ -->
        <!-- Card                                                         -->
        <!-- ============================================================ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <!-- ============================================================ -->
        <!-- Buttons                                                      -->
        <!-- ============================================================ -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{Binding (Border.Background), RelativeSource={RelativeSource TemplatedParent}}"
                                        />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="24,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrushHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrushHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrushPressed}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrushPressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource CardInnerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="20,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2E3440" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- TextBox                                                       -->
        <!-- ============================================================ -->
        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardInnerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>